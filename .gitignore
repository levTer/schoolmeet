# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# user uploads (homework attachments)
/storage

# windows portable build artifacts (public/eduflow-windows.zip коммитится)
/windows-portable/build

# electron-builder: временные артефакты сборки установщика
# (public/eduflow-setup.exe коммитится — его скачивают пользователи)
/dist
/desktop/build
/windows-build.log

# electron desktop wrapper для macOS (electron-app/): сам DMG ~100 МБ —
# он живёт только в артефактах CI и в GitHub Releases, не в git.
electron-app/node_modules/
electron-app/dist/

# ВАЖНО: public/eduflow.dmg здесь НЕ игнорируется. В main этот файл
# отслеживается намеренно — это закоммиченный HFS+/UDZO launcher-образ
# (56 КБ), его проверяет и пересобирает .github/workflows/build-mac-dmg.yml.
# Игнор скрыл бы изменения важного для лендинга бинаря.

# Android tooling cache and private release signing material
/.cache/
/.android-signing/

# Android local IDE / Gradle output (release APK under public/ is tracked)
/android/.gradle/
/android/local.properties
/android/**/build/
/android-smoke-artifacts/
