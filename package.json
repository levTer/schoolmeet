{
  "name": "eduflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "katex": "0.19.1",
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "icons:generate": "tsx scripts/generate-icons.ts",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "android:build": "bash scripts/build-android.sh",
    "build:windows": "tsx scripts/build-windows-installer.ts",
    "desktop": "electron desktop",
    "test:ai": "tsx scripts/smoke-ai.ts",
    "test:rules": "tsx --test scripts/rules.test.ts",
    "test:ui": "tsx --test scripts/ui-patterns.test.ts scripts/windows-titlebar.test.tsx",
    "test:pwa": "tsx --test scripts/pwa-install.test.tsx",
    "test:chat": "tsx --test scripts/chat-rules.test.ts",
    "test:security": "tsx --test --experimental-test-module-mocks scripts/security-rules.test.ts scripts/admin-tenancy.test.mts",
    "test:calls": "tsx --test scripts/call-lifecycle.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "npm run test:ai && npm run test:rules && npm run test:school && npm run test:ui && npm run test:pwa && npm run test:chat && npm run test:security && npm run test:calls && npm run test:bridge && npm run test:android && npm run test:2fa && npm run test:hardening && npm run test:landing",
    "test:bridge": "tsx --test scripts/whiteboard-bridge.test.ts",
    "test:android": "tsx --test scripts/android-apk.test.ts",
    "test:landing": "tsx --test scripts/landing-auth.test.ts",
    "test:school": "tsx --test scripts/single-class.test.ts",
    "test:hardening": "tsx --test scripts/hardening.test.ts",
    "test:2fa": "tsx --test scripts/two-factor.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "fabric": "^7.4.0",
    "katex": "0.19.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
