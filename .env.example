# ---------------------------------------------------------------------------
# SchoolMeet — пример переменных окружения (ЭТАП 8).
# Скопируйте файл: cp .env.example .env  и заполните своими значениями.
# Никогда не коммитьте реальный .env в репозиторий.
#
# ВАЖНО: все ИИ-ключи используются ТОЛЬКО на сервере (роут /api/ai).
# Сервер Vercel (Европа) работает прокси-посредником — пользователи в РФ
# получают доступ к Groq и Gemini БЕЗ VPN, а ключи не попадают в браузер.
# Пошаговая инструкция по получению ключей — в DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# База данных (PostgreSQL). Бесплатно за 1 минуту: Neon.tech или Supabase
# (см. DEPLOYMENT.md, шаг 1). Локально: postgresql://postgres:postgres@localhost:5432/schoolmeet
DATABASE_URL="postgresql://user:password@localhost:5432/schoolmeet?schema=public"

# Секрет для подписи JWT-сессий NextAuth.
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"

# Публичный адрес приложения (используется NextAuth для колбэков).
# На Vercel — адрес деплоя, например https://schoolmeet.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Часовой пояс школы: расписание, дедлайны ДЗ и таймер «До следующего урока».
# Используется и на сервере, и в браузере (префикс NEXT_PUBLIC_).
NEXT_PUBLIC_SCHOOL_TIMEZONE="Europe/Moscow"

# Каталог для файлов, которые прикрепляют ученики к домашним заданиям.
# Не публикуйте его через веб-сервер. По умолчанию — ./storage/uploads (каталог /storage игнорируется Git).
# ВНИМАНИЕ: на serverless-хостинге (Vercel) диск эфемерный — для продакшена
# подключите объектное хранилище (см. DEPLOYMENT.md, раздел «Файлы ДЗ»).
UPLOAD_DIR="./storage/uploads"

# Порт и адрес, на которых поднимается сервер (Next.js + Socket.IO на одном порту)
PORT="3000"
HOST="0.0.0.0"

# ---------------------------------------------------------------------------
# ИИ-ДВИЖОК (ЭТАП 8): Groq + Gemini Flash + OpenRouter + локальный Mock.
# Авто-цепочка (src/lib/ai-provider.ts → AutoAIProvider):
#   • текст/задача/чертёж/проверка ДЗ → Groq → OpenRouter :free → Gemini → Mock;
#   • изображение доски (распознавание формулы) → Gemini Vision → OpenRouter Vision → Mock.
# Ни один ключ НЕ обязателен: без них всё работает на локальном MockAIProvider.
# Все переменные БЕЗ префикса NEXT_PUBLIC_ — только для сервера.
# ---------------------------------------------------------------------------

# Groq Cloud — самый быстрый бесплатный текстовый ИИ (14 400 запросов/день).
# Ключ: https://console.groq.com/keys (бесплатно, без карты).
GROQ_API_KEY=""
# Модели Groq (необязательно, значения по умолчанию):
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_REASONING_MODEL="deepseek-r1-distill-llama-70b"

# Google Gemini Flash — мультимодальный Vision (1 500 запросов/день бесплатно).
# Ключ: https://aistudio.google.com/apikey (бесплатно, без карты).
GEMINI_API_KEY=""
# Модель Gemini (необязательно; при 404 автоматически пробуется gemini-1.5-flash):
GEMINI_MODEL="gemini-2.0-flash"

# OpenRouter — резервный доступ к бесплатным :free моделям.
# Ключ: https://openrouter.ai/settings/keys. Список :free-моделей:
# https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=""
# Модели OpenRouter (необязательно):
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_VISION_MODEL="google/gemini-2.0-flash-exp:free"

# Принудительный выбор провайдера: auto (по умолчанию) | groq | gemini | openrouter | mock.
AI_PROVIDER="auto"
# Таймаут одного внешнего ИИ-вызова, мс (по умолчанию 30000).
# AI_TIMEOUT_MS="30000"

# ---------------------------------------------------------------------------
# Rate-limit (защита от флуда и брутфорса, src/lib/rate-limit.ts)
# ---------------------------------------------------------------------------
# Общий лимит запросов на один IP в окне. У stricter-областей свои значения:
#   /api/auth  — 20/мин (защита пароля), /api/admin — 60/мин,
#   рукопожатия Socket.IO — 40/мин.
RATE_LIMIT_MAX_REQUESTS="100"
# Длина окна лимита в миллисекундах.
RATE_LIMIT_WINDOW_MS="60000"

# ---------------------------------------------------------------------------
# WebRTC: STUN/TURN (src/lib/webrtc-config.ts)
# ---------------------------------------------------------------------------
# По умолчанию используются проверенные публичные STUN-серверы Google
# (stun.l.google.com:19302 и зеркала stun1…stun4) — ничего задавать не нужно.
#
# Для школьных Wi-Fi сетей с симметричным NAT и строгими файрволами добавьте
# свои TURN-релеи (JSON-массив; поддержка строк "turn:host:port" и объектов):
# NEXT_PUBLIC_TURN_SERVERS='[{"urls":"turn:turn.school.ru:3478","username":"schoolmeet","credential":"secret"},{"urls":"turns:turn.school.ru:5349","username":"schoolmeet","credential":"secret"}]'
# Бесплатные тестовые TURN: https://www.metered.ca/tools/openrelay/
NEXT_PUBLIC_TURN_SERVERS=""

# Legacy-переменная: ПОЛНЫЙ override списка ICE-серверов (имеет приоритет
# над STUN Google + NEXT_PUBLIC_TURN_SERVERS). JSON-массив RTCIceServer:
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.example.org:3478"},{"urls":"turn:turn.example.org:3478","username":"u","credential":"p"}]'
NEXT_PUBLIC_ICE_SERVERS=""

# ---------------------------------------------------------------------------
# Демо-аккаунты (только локальная разработка)
# ---------------------------------------------------------------------------

# Показывать блок с демо-доступами на странице входа: 1 — показывать, 0 — скрыть.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="0"

# Пароль демо-аккаунтов (используется и сидом `npm run db:seed`).
SEED_PASSWORD="schoolmeet"
NEXT_PUBLIC_DEMO_PASSWORD="schoolmeet"
