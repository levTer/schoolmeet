# ---------------------------------------------------------------------------
# SchoolMeet — пример переменных окружения.
# Скопируйте файл: cp .env.example .env  и заполните своими значениями.
# Никогда не коммитьте реальный .env в репозиторий.
# ---------------------------------------------------------------------------

# База данных (PostgreSQL). Локально: postgresql://postgres:postgres@localhost:5432/schoolmeet
DATABASE_URL="postgresql://user:password@localhost:5432/schoolmeet?schema=public"

# Секрет для подписи JWT-сессий NextAuth.
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"

# Публичный адрес приложения (используется NextAuth для колбэков)
NEXTAUTH_URL="http://localhost:3000"

# Часовой пояс школы: расписание, дедлайны ДЗ и таймер «До следующего урока».
# Используется и на сервере, и в браузере (префикс NEXT_PUBLIC_).
NEXT_PUBLIC_SCHOOL_TIMEZONE="Europe/Moscow"

# Каталог для файлов, которые прикрепляют ученики к домашним заданиям.
# Не публикуйте его через веб-сервер. По умолчанию — ./storage/uploads (каталог /storage игнорируется Git).
UPLOAD_DIR="./storage/uploads"

# Ключ внешнего ИИ (GPT-4o Vision) для разбора формул и задач.
# НА ЭТАПЕ 4 НЕ ИСПОЛЬЗУЕТСЯ: ИИ-помощник работает 100% локально через
# MockAIProvider (src/lib/ai-provider.ts), внешних вызовов нет. Ключ понадобится
# только в финальном этапе проекта.
OPENAI_API_KEY="sk-your-openai-api-key"

# Порт и адрес, на которых поднимается сервер (Next.js + Socket.IO на одном порту)
PORT="3000"
HOST="0.0.0.0"

# ICE-серверы для WebRTC (JSON-массив RTCIceServer). Если не задано — публичный STUN.
# Для школьных сетей с симметричным NAT добавьте свой TURN-сервер, например:
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.example.org:3478"},{"urls":"turn:turn.example.org:3478","username":"user","credential":"pass"}]'
NEXT_PUBLIC_ICE_SERVERS=""

# ---------------------------------------------------------------------------
# Демо-аккаунты (только локальная разработка)
# ---------------------------------------------------------------------------

# Показывать блок с демо-доступами на странице входа: 1 — показывать, 0 — скрыть.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="0"

# Пароль демо-аккаунтов (используется и сидом `npm run db:seed`).
SEED_PASSWORD="schoolmeet"
NEXT_PUBLIC_DEMO_PASSWORD="schoolmeet"
