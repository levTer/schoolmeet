// Лицей Сингулярити — схема базы данных
// Документация по Prisma schema: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Роли пользователей платформы
// ADMIN   — управляет платформой, модерация, доступ ко всем данным
// TEACHER — создаёт уроки, планирует расписание, проверяет ДЗ
// STUDENT — посещает уроки, смотрит расписание своего класса, сдаёт ДЗ
// ---------------------------------------------------------------------------
/// Lifecycle of a video room. `idle` also covers scheduled rooms before join.
enum MeetingStatus {
  idle
  active
  ended
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

/// Класс обучения (5–11). Учитель и администратор класса не имеют.
enum ClassGrade {
  GRADE_5
  GRADE_6
  GRADE_7
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
}

/// DRAFT — ученик заполняет ответ (черновик), SUBMITTED — сдано, на проверке,
/// GRADED — учитель утвердил оценку, её видит ученик.
enum HomeworkSubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
}

/// Организация-арендатор: пользователи и учебные данные изолированы по школе.
model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  /// Секретная ссылка-приглашение для регистрации учителей
  /// (`/auth/register?code=…&invite=…`): только с этим токеном выдаётся роль TEACHER.
  ///
  /// Nullable ОБЯЗАТЕЛЬНО: `@default(uuid())` Prisma считает на клиенте, а не в БД,
  /// поэтому NOT NULL-колонку без DB-level default нельзя добавить в уже заполненную
  /// таблицу — `prisma db push` падал на Render («The required column `adminInviteToken`
  /// was added to the `schools` table…»). Значения выпускает приложение
  /// (`src/lib/invite-tokens.ts`, досоздание — `backfillSchoolInviteTokens`).
  teacherInviteToken String?  @unique
  /// Секретная ссылка-приглашение для назначения администраторов: только с этим
  /// токеном выдаётся роль ADMIN (регистрация или повышение уже вошедшего аккаунта).
  /// Тоже nullable — по той же причине, что и `teacherInviteToken`.
  adminInviteToken   String?  @unique
  /// Политика изоляции классов школы (H-02, расширение):
  ///  - `true`  (STRICT)  — ученик заходит только в уроки СВОЕГО класса
  ///    (`user.classId === schedule.classId`) либо с правильным кодом класса
  ///    (`Class.code`, временный разовый допуск — `src/lib/class-code.ts`);
  ///  - `false` (FLEXIBLE) — ученик может заходить на ЛЮБЫЕ уроки своей школы.
  /// Лицей Сингулярити по умолчанию строгий, остальные школы — гибкие
  /// (`CONFIGURED_SCHOOLS` в `src/lib/school-config.ts`, синхронизируется при
  /// старте в `provisionConfiguredSchools`).
  strictClassIsolation Boolean  @default(false)
  createdAt DateTime @default(now())

  users         User[]
  classes       Class[]
  lessons       Schedule[]
  homeworks     Homework[]
  meetings      Meeting[]
  announcements Announcement[]
  auditLogs     AuditLog[]

  @@map("schools")
}

/// Учебная группа школы, например «5-А» или «11-Б».
model Class {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  /// Код класса для приглашений в строгих школах (`strictClassIsolation`):
  /// ученик другого класса получает вход в урок, введя этот код
  /// (разовый допуск — `src/lib/class-code.ts`). Значение выпускает
  /// provisioning (`backfillClassCodes` в `src/lib/schools.ts`), поэтому
  /// nullable: в старом деплое у существующих строк кода нет.
  code      String?  @unique
  createdAt DateTime @default(now())

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users     User[]
  lessons   Schedule[]
  homeworks Homework[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  password  String // bcrypt-хеш, никогда не отдаётся клиенту
  name      String
  role      Role        @default(STUDENT)
  /// Класс ученика (параллель сохраняется для старых интерфейсов и миграции).
  grade     ClassGrade?
  /// Школа и конкретный учебный класс. Nullable для безопасного расширения старой БД.
  schoolId  String?
  classId   String?
  avatar    String?
  /// Блокировка аккаунта администратором: вход запрещён, живые сокет-сессии
  /// разрываются (см. `src/lib/realtime-control.ts`).
  isBanned  Boolean     @default(false)
  /// Версия сессии: увеличивается при смене пароля, роли или блокировке.
  /// JWT хранит версию на момент выпуска, и расхождение с БД аннулирует сессию
  /// (см. `src/lib/auth-token.ts`), — так смена пароля отзывает все токены.
  sessionVersion Int    @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Связи
  hostedMeetings   Meeting[]            @relation("MeetingHost")
  schedules        Schedule[]           @relation("ScheduleTeacher")
  homeworks        Homework[]           @relation("HomeworkTeacher")
  submissions      HomeworkSubmission[] @relation("SubmissionStudent")
  reviews          HomeworkReview[]     @relation("HomeworkReviewer")
  /// Сообщения, которые пользователь отправил в чатах уроков.
  messages         ChatMessage[]        @relation("ChatMessageAuthor")
  /// Приватные сообщения, адресованные пользователю.
  receivedMessages ChatMessage[]        @relation("ChatMessageRecipient")
  announcements    Announcement[]
  attendance       AttendanceRecord[]
  auditLogs        AuditLog[]
  school           School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolClass      Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([grade])
  @@index([schoolId, role])
  @@index([classId])
  @@index([isBanned])
  @@map("users")
}

model Meeting {
  id            String    @id @default(cuid())
  title         String
  meetingCode   String    @unique // короткий код комнаты, например "matematika-8b"
  hostId        String
  startTime     DateTime  @default(now())
  endTime       DateTime?
  isActive      Boolean   @default(false)
  status        MeetingStatus @default(idle)
  /// Actual first join, distinct from the scheduled/created startTime.
  callStartedAt DateTime?
  encryptionKey String // ключ комнаты для AES-256 шифрования чата
  /// Школа-владелец комнаты; nullable только для миграции старых записей.
  schoolId      String?

  // Связи
  host     User              @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
  school   School?           @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  schedule Schedule?
  attendance AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([schoolId])
  @@index([isActive])
  @@index([status])
  @@map("meetings")
}

/// Предмет школьной программы.
model Subject {
  id    String @id @default(cuid())
  name  String @unique
  /// Фирменный цвет предмета в HEX, например "#a855f7". Из него строится градиент карточки.
  color String
  /// Эмодзи предмета для карточки урока.
  emoji String

  schedules Schedule[]
  homeworks Homework[]

  @@map("subjects")
}

/// Слот еженедельного расписания: предмет, учитель, класс, день и время.
model Schedule {
  id          String     @id @default(cuid())
  subjectId   String
  teacherId   String
  /// Параллель сохранена для обратной совместимости; новые записи дополнительно привязаны к классу.
  grade       ClassGrade
  schoolId    String?
  classId     String?
  dayOfWeek   Int // 1 = понедельник ... 7 = воскресенье (ISO-8601)
  startTime   String // "HH:mm", например "09:00"
  endTime     String // "HH:mm", например "09:45"
  room        String? // кабинет или «онлайн»
  /// Комната урока (Meeting.meetingCode), создаётся вместе со слотом.
  meetingCode String     @unique

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher     User     @relation("ScheduleTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  meeting     Meeting  @relation(fields: [meetingCode], references: [meetingCode], onDelete: Cascade)
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolClass Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grade, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([schoolId, classId, dayOfWeek])
  @@index([classId])
  @@map("schedules")
}

/// Домашнее задание, назначенное классу учителем.
model Homework {
  id          String     @id @default(cuid())
  title       String
  /// Условие в Markdown с LaTeX-формулами ($…$ и $$…$$).
  description String
  subjectId   String
  teacherId   String
  /// Параллель оставлена для совместимости, новые задания адресуются конкретному классу.
  grade       ClassGrade
  schoolId    String?
  classId     String?
  deadline    DateTime
  /// Максимальный балл (по умолчанию пятибалльная шкала).
  maxScore    Int        @default(5)

  subject     Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher     User                 @relation("HomeworkTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  school      School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolClass Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  submissions HomeworkSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grade, deadline])
  @@index([teacherId])
  @@index([schoolId, classId, deadline])
  @@index([classId])
  @@map("homeworks")
}

/// Ответ ученика на ДЗ. Один ученик — одна запись на задание (черновик → сдача).
model HomeworkSubmission {
  id           String                   @id @default(cuid())
  homeworkId   String
  studentId    String
  /// Текст ответа (черновик или финальная версия).
  answer       String                   @default("")
  status       HomeworkSubmissionStatus @default(DRAFT)
  draftSavedAt DateTime?
  submittedAt  DateTime?

  homework    Homework             @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     User                 @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  attachments HomeworkAttachment[]
  review      HomeworkReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([homeworkId, studentId])
  /// Дашборд и «мои задания» фильтруют строго по ученику:
  /// `where: { studentId, status }` — без этого индекса это seq scan.
  @@index([studentId, status])
  @@index([status])
  @@map("homework_submissions")
}

/// Файл, приложенный к ответу. Сами файлы лежат на диске, в БД — только метаданные.
model HomeworkAttachment {
  id           String @id @default(cuid())
  submissionId String
  fileName     String
  mimeType     String
  size         Int
  /// Имя файла в каталоге загрузок (генерируется сервером, не из пользовательского ввода).
  storageKey   String @unique

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@map("homework_attachments")
}

/// Проверка ответа учителем.
/// Поля `aiSuggested*` / `aiDraft*` — черновик ИИ, виден ТОЛЬКО учителю.
/// Поля `grade` / `comment` / `approvedAt` — утверждённая учителем оценка, её видит ученик.
model HomeworkReview {
  id           String @id @default(cuid())
  submissionId String @unique
  reviewerId   String

  aiSuggestedGrade Int?
  aiDraftComment   String?
  aiDraftedAt      DateTime?

  grade      Int?
  comment    String?
  approvedAt DateTime?

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User               @relation("HomeworkReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homework_reviews")
}

model ChatMessage {
  id          String   @id @default(cuid())
  meetingId   String
  /// Автор сообщения.
  userId      String
  /// Получатель приватного сообщения; `null` — сообщение публичное, его видит вся комната.
  recipientId String?
  content     String // зашифрованный AES-256 текст (base64) либо открытый текст
  encrypted   Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Связи
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation("ChatMessageAuthor", fields: [userId], references: [id], onDelete: Cascade)
  recipient User?   @relation("ChatMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId])
  @@index([recipientId])
  @@map("chat_messages")
}

/// Посещение виде урока. Одна запись — один вход участника в комнату:
/// создаётся при `join-room`, закрывается (leftAt + durationMinutes) при выходе,
/// разрыве соединения или принудительном завершении урока администратором.
model AttendanceRecord {
  id              String    @id @default(cuid())
  meetingId       String
  userId          String
  joinedAt        DateTime  @default(now())
  /// null — участник ещё в комнате (или сессию закрыл администратор).
  leftAt          DateTime?
  /// Сколько минут участник провёл в уроке; заполняется при закрытии записи.
  durationMinutes Int       @default(0)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId, joinedAt])
  @@map("attendance_records")
}

/// Общешкольное объявление. `targetGrade = null` — объявление для всей школы,
/// иначе его видят только ученики и учителя указанного класса.
model Announcement {
  id          String      @id @default(cuid())
  title       String
  /// Текст объявления (Markdown с LaTeX-формулами, рендерит Markdown-компонент).
  content     String
  targetGrade ClassGrade?
  authorId    String
  /// Черновик/архив (false) не показывается в баннере кабинета.
  isActive    Boolean     @default(true)
  /// Школа-владелец объявления (мультиарендность): объявление видно только
  /// внутри своей школы. Nullable — как и другие tenant-колонки, добавленные к
  /// уже заполненной таблице; значение досыпает приложение
  /// (`backfillAnnouncementSchools` в `src/lib/schools.ts`), а чтение,
  /// обновление и удаление всегда фильтруются по школе сессии.
  schoolId    String?

  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
  @@index([targetGrade])
  @@index([schoolId, isActive, createdAt])
  @@map("announcements")
}

/// Журнал действий администрации: смена ролей, блокировки, завершение уроков,
/// управление объявлениями. Пишется из API-роутов (`src/lib/audit.ts`).
model AuditLog {
  id      String @id @default(cuid())
  /// Immutable tenant ownership. Legacy null rows stay hidden until backfilled.
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  /// Автор действия. null — системное событие; при удалении автора лог остаётся.
  userId  String?
  /// Машинный код действия, например "user.ban" (см. AUDIT_ACTIONS).
  action  String
  /// Человекочитаемые детали (короткий JSON), например { "target": "..." }.
  details String?
  /// IP автора действия (x-forwarded-for / x-real-ip).
  ip      String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([schoolId, createdAt])
  @@map("audit_logs")
}
